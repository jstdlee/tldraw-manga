{
  "name": "tldraw-manga",
  "private": true,
  "version": "0.1.0",
  "description": "Mouse-driven manga storyboard desk",
  "author": "jstdlee",
  "desktopName": "tldraw-manga.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && electron-builder --dir",
    "dist:linux-arm64": "npm run build && electron-builder --linux AppImage tar.gz --arm64 --publish never",
    "dist:win-x64": "npm run build && electron-builder --win portable zip --x64 --publish never",
    "dist:all": "npm run build && electron-builder --linux AppImage tar.gz --arm64 --win portable zip --x64 --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
